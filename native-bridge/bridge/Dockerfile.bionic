# owlet-bridge (Bionic) — runs the Owlet Android/Kalay TUTK libraries under a
# Termux (Bionic) userspace so they actually load on an x86_64 Linux box. The
# glibc build can't (the libs are Android, linked to Bionic's `LIBC`). Same web
# UI, same KMS auto-fetch, same tutk_client — only the runtime changes.

# go2rtc is a static Go binary (no libc dependency) — grab it in a tiny stage.
FROM debian:stable-slim AS dl
ARG GO2RTC_VERSION=1.9.4
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates fonts-dejavu-core \
 && curl -fsSL -o /go2rtc \
      "https://github.com/AlexxIT/go2rtc/releases/download/v${GO2RTC_VERSION}/go2rtc_linux_amd64" \
 && chmod +x /go2rtc \
 && cp /usr/share/fonts/truetype/dejavu/DejaVuSans.ttf /DejaVuSans.ttf

FROM termux/termux-docker:x86_64

# 1) Run Termux's bootstrap second stage (the entrypoint does this at container
#    start; we need it now so the package manager works during the build).
RUN /entrypoint.sh bash -c 'true'

# 2) Install python + ffmpeg + pip deps as the Termux user (pkg/apt refuse root).
#    - procps: ps/pkill/fuser for debugging the stream pipeline.
#    - openssl-tool: the `openssl` command. Termux ships the library (`openssl`,
#      pulled in by python/ffmpeg) and the CLI as separate packages; without the
#      CLI start-bionic.sh cannot generate the self-signed cert and the control
#      panel silently falls back to plain HTTP.
#    - paho-mqtt<2.0: 2.x changed Client() to require a CallbackAPIVersion; pin to
#      the 1.x API the code targets (code is also version-aware as a backstop).
USER 1000
RUN bash -lc 'yes | pkg install -y python ffmpeg procps openssl-tool && pip install --no-cache-dir requests flask "paho-mqtt<2.0"'
USER 0

COPY --from=dl /go2rtc /usr/local/bin/go2rtc
COPY --from=dl /DejaVuSans.ttf /app/fonts/DejaVuSans.ttf
COPY owlet_api.py owlet_vitals.py vitals_poller.py tutk_client.py webapp.py lib_extract.py config_store.py login_guard.py render_streams.py keepalive.py watchdog.py go2rtc.yaml start-bionic.sh /app/
COPY templates /app/templates
COPY static /app/static
RUN chmod +x /app/start-bionic.sh

# Our entrypoint = the stock Termux one + forwarding of the bridge's own
# `docker -e` vars (OWLET_*, PUBLIC_*, GO2RTC_*, TUTK_*, CONFIG_PATH, ENV_PATH)
# through the `su … env -i` wipe. Without it every template variable was
# silently dropped before the app started.
COPY entrypoint-bionic.sh /entrypoint.sh
RUN chmod 755 /entrypoint.sh

# Standard shell paths. The Termux base has no /bin at all (its shells live
# under /data/data/com.termux/files/usr/bin), which broke `docker exec … sh -c`,
# the Unraid console button (<Shell>bash</Shell>) and any shell-form Docker
# instruction. Symlinks make the image behave like a normal Linux container.
RUN mkdir -p /bin \
 && ln -sf /data/data/com.termux/files/usr/bin/sh /bin/sh \
 && ln -sf /data/data/com.termux/files/usr/bin/bash /bin/bash

ENV TUTK_LIB_DIR=/app/libs/x86_64 \
    LD_LIBRARY_PATH=/app/libs/x86_64:/data/data/com.termux/files/usr/lib \
    PATH=/data/data/com.termux/files/usr/bin:/usr/local/bin:/usr/bin:/bin \
    CONFIG_PATH=/config/owlet.yaml \
    ENV_PATH=/config/owlet.env

VOLUME ["/config"]
EXPOSE 8088 1984 8554 8555/tcp 8555/udp

# Report unhealthy when a configured camera's RTSP serves no frames (a wedged
# P2P session). The in-container watchdog is what actually self-heals; this just
# surfaces the state (e.g. red dot in Unraid). --check exits 0 healthy / 1 dead.
# Exec form (JSON array), NOT shell form: this base has no /bin/sh (same reason
# ENTRYPOINT can't be overridden with an interpreter — see note below). Shell
# form silently always reports unhealthy ("stat /bin/sh: no such file").
# start-period matches watchdog.py's OWLET_WATCHDOG_GRACE (60s) plus a buffer for
# the first probe cycle — was 180s to match the old, slower watchdog timers
# (TOT-33 tuned both down together; see watchdog.py for the reasoning).
HEALTHCHECK --interval=60s --timeout=25s --start-period=90s --retries=3 \
  CMD ["python3", "/app/watchdog.py", "--check"]
# The ENTRYPOINT stays the base image's /entrypoint.sh path (ours, copied above:
# drops to the Termux user, then execs our CMD). Do NOT override ENTRYPOINT with
# an explicit interpreter — the entrypoint must run as root first so it can `su`
# to the Termux user. The UI/config remains the primary way to configure the
# bridge; the whitelisted docker -e vars are forwarded as overrides.
CMD ["/app/start-bionic.sh"]
